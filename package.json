{
  "name": "hyunjoongkim",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check && next build && npm run verify:static-home",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/**/*.test.ts\"",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:validate:strict": "tsx scripts/validate-content.ts --strict",
    "content:validate:automation": "tsx scripts/validate-blog-automation.ts",
    "content:validate:assets": "tsx scripts/validate-content-assets.ts",
    "content:verify": "npm run content:validate:strict && npm run content:validate:automation && npm run content:validate:assets",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm test && npm run content:verify && npm run lint && npm run typecheck",
    "verify": "npm run build && npm run security:audit",
    "verify:static-home": "tsx scripts/verify-static-home.ts"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@types/mdx": "^2.0.13",
    "@vercel/speed-insights": "^1.3.1",
    "lucide-react": "^0.562.0",
    "negotiator": "^1.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
