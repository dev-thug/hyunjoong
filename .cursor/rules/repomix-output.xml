  useEffect(() => {
    const interval = setInterval(() => {
      setLiveVisitors(prev => Math.max(100, prev + (Math.floor(Math.random() * 5) - 2)));
      if (Math.random() > 0.8) {
         setData(prev => {
            const newData = [...prev];
            const last = newData[newData.length - 1];
